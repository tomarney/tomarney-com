---
import FormattedDate from "../components/FormattedDate.astro";
import Page from "./Page.astro";
import { SITE_TITLE } from "../consts";

const {
  title,
  publishedDate,
  status,
  publicationFull,
  doi,
  url,
  type,
  authorString,
  bib,
} = Astro.props;
---

<Page title={`${title} – ${SITE_TITLE}`}>
  <main>
    <article class="prose-h1:text-xl md:prose-h1:text-2xl prose-h1:leading-relaxed prose-h2:text-xl prose-h3:text-lg">

      <p class="text-lg text-stone-400 font-thin -mt-6">{type}</p>

      <h1 class="mb-4">{title}</h1>

      <p class="text-stone-600">{authorString}</p>

      <div class="text-stone-500 text-sm">
        <p>
          {
            status == "Accepted" && (
              <>
                Accepted for publication in <i>{publicationFull}</i>
              </>
            )
          }
          {
            status == "In press" && (
              <>
                In press at <i>{publicationFull}</i>
              </>
            )
          }
          {
            status == "Published" && (type == "Article" || type == "Thesis") && (
              <>
                <span class="pr-2">
                  <i class="font-semibold">{publicationFull}</i>
                  {bib?.volume && ` vol. ${bib.volume} `}
                  {bib?.issue && ` no. ${bib.issue} `}
                  (<FormattedDate date={publishedDate} day={false} />)
                  {bib?.pages && (/^\d+$/.test(bib.pages) ? ` ${bib.pages} pp. ` : ` pp. ${bib.pages} `)}
                </span>
                {doi && (
                  <span class="inline-block">
                    DOI:<a class="not-prose" href={"https://doi.org/" + doi}>
                      {doi}
                    </a>
                  </span>
                )}
              </>
            )
          }
          {
            status == "Published" && type == "Talk" && (
              <>
                {publicationFull}<span class="pr-2"></span>
                <span class="pr-2">(<FormattedDate date={publishedDate} />)</span>
                {doi && (
                  <span class="inline-block">
                    DOI:<a class="not-prose" href={"https://doi.org/" + doi}>
                      {doi}
                    </a>
                  </span>
                )}
              </>
            )
          }
        </p>
        {
          status == "Published" && (doi || url) && (
            <p>
              <a href={doi ? "https://doi.org/" + doi : url}>View at publisher</a>
            </p>
          )
        }
      </div>

      <slot />
    </article>
  </main>
</Page>
